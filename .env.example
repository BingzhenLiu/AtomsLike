# AtomForge runtime configuration.
#
# These are read on the server for every request, never at build time, so the
# same image can run in Demo Mode or against a real model depending on what the
# runtime injects. Never prefix any of them with NEXT_PUBLIC_: that would ship
# the value to the browser.
#
# Local dev      cp .env.example .env.local && npm run dev
# Docker Compose cp .env.example .env && docker compose up --build
#
# All three may stay empty. The app then runs in Demo Mode with its built-in
# examples; only AI_API_KEY and AI_MODEL together enable real generation.

# API key for the OpenAI-compatible endpoint below.
AI_API_KEY=

# Base URL of an OpenAI-compatible /chat/completions API, including its path
# prefix. Falls back to the public OpenAI endpoint when empty. Any compatible
# gateway works, for example https://api.minimax.chat/v1 (model MiniMax-M3).
AI_BASE_URL=https://api.openai.com/v1

# Model id to call. Must be set explicitly; there is no default model.
AI_MODEL=
